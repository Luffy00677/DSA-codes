#include <iostream>
using namespace std;

void quick_sort(int arr[], int low, int high) {
    int pivot = arr[low];
    int i = low + 1;
    int j = high;

    while (i <= j) {
        while (i <= high && arr[i] <= pivot) i++;
        while (j >= low && arr[j] > pivot) j--;
        if (i < j) {
            swap(arr[i], arr[j]);
        }
    }
    swap(arr[low], arr[j]);
    quick_sort(arr, low, j - 1);
    quick_sort(arr, j + 1, high);
}

int main() {
    int arr[7] = {12, 20, 5, 7, 10, 9, 6};

    quick_sort(arr, 0, 6);

    for (int i = 0; i < 7; i++)
        cout << arr[i] << " ";
    return 0; 
}
