#include <iostream>
using namespace std;

int main() {
    int arr[] = {1,2,0,3,0};
    int i = 0;
    for(int j =0; j < 5; j++){
        if(arr[j] != 0){
            arr[i] = arr[j];
            i++;
        }
    }
     while (i < 5){
        arr[i] = 0;
        i++;
}
    for(int i = 0; i < 5; i++){
        cout << arr[i] << " ";
    }
    return 0;
}
