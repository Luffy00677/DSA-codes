#include <iostream>
using namespace std;
 
int tipscounter(float speed){
    int bounce=0;
    while(speed > 0.001){
        speed=speed/2;
        bounce ++;
    }
    return bounce;
}

int main() {
    float speed;
    cout << "speed=";
    cin >> speed;
    cout << tipscounter(speed);
    return 0;
}
