#include <iostream>
#include <algorithm>
using namespace std;

void heapify(int a[], int n, int i);

void createHeap(int a[], int n) {
    for(int i = n/2-1; i >= 0; i--)
        heapify(a, n, i);
}

void heapify(int a[], int n, int i) {
    int largest = i;
    int l = 2*i+1, r = 2*i+2;

    if(l < n && a[l] > a[largest])
        largest = l;

    if(r < n && a[r] > a[largest])
        largest = r;

    if(largest != i) {
        swap(a[i], a[largest]);
        heapify(a, n, largest);
    }
}

void insert(int a[], int &n, int x) {
    int i = n++;
    a[i] = x;

    while(i > 0 && a[(i-1)/2] < a[i]) {
        swap(a[i], a[(i-1)/2]);
        i = (i-1)/2;
    }
}

void deleteMax(int a[], int &n) {
    if(n == 0) return;

    a[0] = a[--n];
    heapify(a, n, 0);
}

bool search(int a[], int n, int x) {
    for(int i = 0; i < n; i++)
        if(a[i] == x)
            return true;

    return false;
}

void heapSort(int a[], int n) {
    createHeap(a, n);

    for(int i = n-1; i > 0; i--) {
        swap(a[0], a[i]);
        heapify(a, i, 0);
    }
}

int main() {
    int a[100] = {10, 20, 15, 30, 40};
    int n = 5;

    createHeap(a, n);
    cout << "Max heap: ";
    for(int i = 0; i < n; i++)
        cout << a[i] << " ";
    cout << endl;

    insert(a, n, 50);
    cout << "After insertion: ";
    for(int i = 0; i < n; i++)
        cout << a[i] << " ";
    cout << endl;

    cout << "Search 30: " << (search(a, n, 30) ? "Found" : "Not found") << endl;

    deleteMax(a, n);
    cout << "After deleting maximum: ";
    for(int i = 0; i < n; i++)
        cout << a[i] << " ";
    cout << endl;

    heapSort(a, n);
    cout << "Heap sort: ";
    for(int i = 0; i < n; i++)
        cout << a[i] << " ";
    cout << endl;

    return 0;
}
