#include <iostream>
using namespace std;

int maximum(int a[], int n) {
    int max = a[0];
    for (int i = 1; i < n; i++) {
        if (max < a[i]) {
            max = a[i];
        }
    }
return max;
}

void bin(int a[], int n) {

    int great = maximum(a, n);
    int bins[100][100] = {0};
    int count[100] = {0};
     for (int i = 0; i < n; i++) {
        bins[a[i]][count[a[i]]] = a[i];
        count[a[i]]++;
    }
    int k = 0;
for (int i = 0; i <= great; i++) {
        for (int j = 0; j < count[i]; j++) {
            a[k] = bins[i][j];
            k++;
        }
    }
}
int main() {
   int a[] = {5, 2, 8, 3, 1, 4, 2};
    int n = 7;
    bin(a, n);
    cout << "Sorted array: ";
    for (int i = 0; i < n; i++) {
        cout << a[i] << " ";
    }
    return 0;
}
