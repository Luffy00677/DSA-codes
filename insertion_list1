#include <iostream>
using namespace std;

struct node{
    int data;
    node* next;
};

int main() {
   node* head = new node{2,NULL};
   head->next = new node {3,NULL};
   head->next->next =new node {4,NULL};
   head->next->next->next =  new node {5,NULL};

   node* newnode = new node{1,NULL};
  head = newnode;


   node* temp = head;
   while(temp != NULL){
    cout <<temp->data;
    temp = temp->next;
   }
   return 0;
}
