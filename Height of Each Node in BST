#include <iostream>
#include <algorithm>
using namespace std;

struct node {
    int data;
    node *left, *right;
};

node* create(int x) {
    node* p = new node;
    p->data = x;
    p->left = p->right = NULL;
    return p;
}

node* insert(node* root, int x) {
    if(root == NULL)
        return create(x);

    if(x < root->data)
        root->left = insert(root->left, x);
    else
        root->right = insert(root->right, x);

    return root;
}

int height(node* root) {
    if(root == NULL)
        return -1;

    return 1 + max(height(root->left),
                    height(root->right));
}

void nodeHeight(node* root) {
    if(root == NULL)
        return;

    cout << root->data << " : "
         << height(root) << endl;

    nodeHeight(root->left);
    nodeHeight(root->right);
}

int main() {
    node* root = NULL;

    root = insert(root, 50);
    root = insert(root, 30);
    root = insert(root, 70);
    root = insert(root, 20);
    root = insert(root, 40);
    root = insert(root, 60);
    root = insert(root, 80);

    nodeHeight(root);

    return 0;
}
