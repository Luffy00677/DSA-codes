#include <iostream>
#include <algorithm>
using namespace std;

struct node {
    int data, h;
    node *left, *right;
};

node* create(int x) {
    node* p = new node;
    p->data = x;
    p->h = 0;
    p->left = p->right = NULL;
    return p;
}

int height(node* root) {
    if(root == NULL)
        return -1;

    return root->h;
}

int balance(node* root) {
    if(root == NULL)
        return 0;

    return height(root->left) - height(root->right);
}

node* rightRotate(node* y) {
    node* x = y->left;
    node* t = x->right;

    x->right = y;
    y->left = t;

    y->h = 1 + max(height(y->left), height(y->right));
    x->h = 1 + max(height(x->left), height(x->right));

    return x;
}

node* leftRotate(node* x) {
    node* y = x->right;
    node* t = y->left;

    y->left = x;
    x->right = t;

    x->h = 1 + max(height(x->left), height(x->right));
    y->h = 1 + max(height(y->left), height(y->right));

    return y;
}

node* insert(node* root, int x) {
    if(root == NULL)
        return create(x);

    if(x < root->data)
        root->left = insert(root->left, x);
    else if(x > root->data)
        root->right = insert(root->right, x);
    else
        return root;

    root->h = 1 + max(height(root->left),
                       height(root->right));

    int b = balance(root);

    if(b > 1 && x < root->left->data)
        return rightRotate(root);

    if(b < -1 && x > root->right->data)
        return leftRotate(root);

    if(b > 1 && x > root->left->data) {
        root->left = leftRotate(root->left);
        return rightRotate(root);
    }

    if(b < -1 && x < root->right->data) {
        root->right = rightRotate(root->right);
        return leftRotate(root);
    }

    return root;
}

void nodeHeight(node* root) {
    if(root == NULL)
        return;

    cout << root->data
         << " Height: " << height(root)
         << " Balance: " << balance(root)
         << endl;

    nodeHeight(root->left);
    nodeHeight(root->right);
}

int main() {
    node* root = NULL;

    root = insert(root, 10);
    root = insert(root, 20);
    root = insert(root, 30);
    root = insert(root, 40);
    root = insert(root, 50);
    root = insert(root, 25);

    nodeHeight(root);

    return 0;
}
